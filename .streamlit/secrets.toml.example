# Copy this file to .streamlit/secrets.toml and fill in your values.
# secrets.toml is listed in .gitignore and must NOT be committed.
#
# On Streamlit Community Cloud, add these via:
# App dashboard → Settings → Secrets

OPENAI_API_KEY = "sk-..."

# HuggingFace credentials (needed for remote model inference)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN = "hf_..."
HF_MODEL_ID = "FranMRL/roberta-amazon-sentiment"
